{"file":"001.bgra.gz","box":[6,6,598,25],"font_px":22.1,"lines":1,"text":"The Resonators gathered at the edge of Jinzhou before dawn.","fill":"#FFFFFF","background":"#132D40","effect":"None","shape":"regular upright stroke=0.071 slant=-0.43","font_px_from_ink":23.711340206185568}
{"file":"002.bgra.gz","box":[6,6,513,27],"font_px":23.9,"lines":1,"text":"I can hear an echo of something old beneath the city.","fill":"#FFFFFF","background":"#132D40","effect":"None","shape":"regular upright stroke=0.070 slant=-0.48","font_px_from_ink":23.711340206185568}
{"file":"003.bgra.gz","box":[5,5,142,23],"font_px":20.4,"lines":1,"text":"Let\u0027s go together.","fill":"#F0F0F0","background":"#322A2F","effect":"None","shape":"regular upright stroke=0.077 slant=-0.45","font_px_from_ink":18.556701030927837}
